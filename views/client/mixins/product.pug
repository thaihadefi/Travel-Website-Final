mixin product-item(item)
  .product-item
    .inner-image
      a(href=`/tour/detail/${item.slug}`)
        img(
          alt=item.name
          src=item.avatar
          )
    .inner-discount
      i.fa-solid.fa-bolt
      | Discount -#{item.discount}%
    .inner-content
      h3.inner-title
        a(href=`/tour/detail/${item.slug}`) #{item.name}
      .inner-prices
        .inner-price-old
          | #{item.priceAdult.toLocaleString("vi-VN")}
          span.inner-unit đ
        .inner-price-new
          | #{item.priceNewAdult.toLocaleString("vi-VN")}
          span.inner-unit đ
      .inner-desc
        .inner-desc-item
          | Departure Date: 
          b #{item.departureDateFormat}
        .inner-desc-item
          | Duration: 
          b #{item.time}
      .inner-meta
        .inner-stock
          .inner-label Available Seats:
          .inner-number #{item.stockAdult}