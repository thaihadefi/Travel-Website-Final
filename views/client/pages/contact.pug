extends ../layouts/default.pug

block main
  // Contact Section
  section.section-contact
    .container
      .row
        .col-lg-6.col-md-12
          .contact-info
            h1.contact-title Contact Us
            p.contact-desc We'd love to hear from you! Feel free to reach out with any questions or inquiries.
            
            .contact-item
              .contact-icon
                <i class="fa-solid fa-location-dot"></i>
              .contact-details
                h3 Address
                p #{settingWebsiteInfo.address}
            
            .contact-item
              .contact-icon
                <i class="fa-solid fa-phone"></i>
              .contact-details
                h3 Phone
                p #{settingWebsiteInfo.phone}
            
            .contact-item
              .contact-icon
                <i class="fa-solid fa-envelope"></i>
              .contact-details
                h3 Email
                p #{settingWebsiteInfo.email}
            
            .contact-item
              .contact-icon
                <i class="fa-solid fa-clock"></i>
              .contact-details
                h3 Working Hours
                p Monday - Friday: 8:00 AM - 6:00 PM
                p Saturday: 9:00 AM - 5:00 PM
                p Sunday: Closed
        
        .col-lg-6.col-md-12
          .contact-form-wrapper
            h2.form-title Send us a message
            form.contact-form(id="contact-form")
              .form-group
                label(for="fullName") Full Name *
                input(type="text" id="fullName" name="fullName" placeholder="Your name")
              
              .form-group
                label(for="email") Email Address *
                input(type="email" id="email" name="email" placeholder="your.email@example.com")
              
              .form-group
                label(for="phone") Phone Number
                input(type="tel" id="phone" name="phone" placeholder="Your phone number (optional)")
              
              .form-group
                label(for="subject") Subject *
                input(type="text" id="subject" name="subject" placeholder="Subject")
              
              .form-group
                label(for="message") Message *
                textarea(id="message" name="message" rows="5" placeholder="Your message...")
              
              button.btn-submit(type="submit") Send Message
  

