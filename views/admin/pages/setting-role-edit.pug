extends ../layouts/default.pug

block main
  
  h1.box-title Edit Role

  //- Section 8
  .section-8
    form(id="setting-role-edit-form")
      .inner-group(style="display: none;")
        label(for="id" class="inner-label") ID
        input(type="text" id="id" name="id" value=roleDetail.id)
      .inner-group
        label(for="name" class="inner-label") Role Name
        input(type="text" id="name" name="name" value=roleDetail.name)
      .inner-group
        label(for="description" class="inner-label") Short Description
        input(type="text" id="description" name="description" value=roleDetail.description)
      .inner-group
        label(class="inner-label") Permissions
        .inner-checkbox-list
          each item in permissionList
            .inner-checkbox-item
              input(
                type="checkbox" 
                id=`permission-${item.value}` 
                name="permissions" 
                value=item.value
                checked=(roleDetail.permissions.includes(item.value))
                )
              label(
                for=`permission-${item.value}` 
                ) #{item.label}
      .inner-button.inner-two-col
        button Update
    .inner-back
      a(href=`/${pathAdmin}/setting/role/list`) Back to List
  //- End Section 8