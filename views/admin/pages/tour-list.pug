extends ../layouts/default.pug
include ../mixins/change-status.pug

block main
  if (permissions.includes("tour-view"))
    h1.box-title Tour Management

    //- Section 4
    .section-4
      .inner-wrap
        .inner-item
          <i class="fa-solid fa-filter"></i> Filter
        .inner-item
          select(filter-status)
            option(value="") Status
            option(value="active") Active
            option(value="inactive") Inactive
        .inner-item
          select(filter-created-by)
            option(value="") Creator
            each item in accountAdminList
              option(value=item.id) #{item.fullName}
        .inner-item
          input(type="date" filter-start-date min="2000-01-01" max="2099-12-31")
          span -
          input(type="date" filter-end-date min="2000-01-01" max="2099-12-31")
        .inner-item
          select(filter-category)
            option(value="") Category
            each item in categoryList
              option(value=item.id) #{item.name}
        .inner-item.inner-reset(filter-reset)
          <i class="fa-solid fa-rotate-left"></i> Reset Filter
    //- End Section 4

    //- Section 5
    .section-5
      .inner-wrap
        if (permissions.includes("tour-edit"))
          +change-status(
            `/${pathAdmin}/tour/change-multi`,
            [
              {
                label: "Active",
                value: "active"
              },
              {
                label: "Inactive",
                value: "inactive"
              },
              {
                label: "Delete",
                value: "delete"
              }
            ]
          )
        .inner-search
          <i class="fa-solid fa-magnifying-glass"></i>
          input(type="text" placeholder="Search" search)
        if (permissions.includes("tour-create"))
          .inner-button-create
            a(href=`/${pathAdmin}/tour/create`) + Create New
        if (permissions.includes("tour-trash"))
          .inner-button-trash
            a(href=`/${pathAdmin}/tour/trash`) Trash
    //- End Section 5

    //- Section 6
    .section-6
      .table-2
        table
          thead
            tr
              th
                input(type="checkbox" class="inner-check" check-all)
              th Tour Name
              th(class="inner-center") Avatar
              th Price
              th Remaining
              th(class="inner-center") Position
              th(class="inner-center") Status
              th Created By
              th Updated By
              th Action
          tbody
            if tourList.length > 0
              each item in tourList
                tr
                  td
                    input(type="checkbox" class="inner-check" check-item=item.id)
                  td #{item.name}
                  td(class="inner-center")
                    img(src=item.avatar class="inner-avatar")
                  td
                    div A: #{item.priceNewAdult.toLocaleString("vi-VN")}đ
                    div C: #{item.priceNewChildren.toLocaleString("vi-VN")}đ
                    div B: #{item.priceNewBaby.toLocaleString("vi-VN")}đ
                  td
                    div A: #{item.stockAdult}
                    div C: #{item.stockChildren}
                    div B: #{item.stockBaby}
                  td(class="inner-center") #{item.position}
                  td(class="inner-center")
                    if (item.status == "active")
                      .badge.badge-green Active
                    else if (item.status == "inactive")
                      .badge.badge-red Inactive
                  td
                    div #{item.createdByFullName}
                    div.inner-time #{item.createdAtFormat}
                  td
                    div #{item.updatedByFullName}
                    div.inner-time #{item.updatedAtFormat}
                  td
                    .inner-buttons
                      if (permissions.includes("tour-edit"))
                        a(href=`/${pathAdmin}/tour/edit/${item.id}` class="inner-edit")
                          <i class="fa-regular fa-pen-to-square"></i>
                      if (permissions.includes("tour-delete"))
                        button(
                          class="inner-delete"
                          button-delete
                          data-api=`/${pathAdmin}/tour/delete/${item.id}`
                          )
                          <i class="fa-regular fa-trash-can"></i>
            else
              tr
                td(colspan="10" style="text-align: center; padding: 40px 20px; color: #999;")
                  | No tours found.
    //- End Section 6

    //- Section 7
    include ../partials/pagination.pug
    //- End Section 7