extends ../layouts/default.pug

block main
  
  h1.box-title Profile

  //- Section 8
  .section-8
    form(id="profile-edit-form")
      .inner-group
        label(for="fullName" class="inner-label") Full Name
        input(type="text" id="fullName" name="fullName" value=account.fullName)
      .inner-group
        label(for="email" class="inner-label") Email
        input(type="email" id="email" name="email" value=account.email)
      .inner-group
        label(for="phone" class="inner-label") Phone Number
        input(type="text" id="phone" name="phone" value=account.phone)
      .inner-group
        label(for="positionCompany" class="inner-label") Position
        input(type="text" id="positionCompany" readonly value=account.positionCompany)
      .inner-group
        label(for="role" class="inner-label") Role
        input(type="text" id="role" readonly value=account.roleName)
      .inner-group.inner-two-col
        label(for="avatar" class="inner-label") Avatar
        .inner-upload-image(image-default=account.avatar)
          input(
            type="file" 
            id="avatar"
            name="avatar"
            filepond-image
            )
      .inner-button.inner-two-col
        button Update
    .inner-back
      a(href=`/${pathAdmin}/profile/change-password`) Change Password
  //- End Section 8