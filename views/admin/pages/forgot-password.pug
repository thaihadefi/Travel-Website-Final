extends ../layouts/account.pug

block main
  .form-account
    h1.inner-title Forgot Password
    .inner-desc Please enter your email to continue

    form.inner-form(id="forgot-password-form")
      .inner-group
        label(
          for="email"
          class="inner-label"
        ) Email
        input(
          type="email"
          name="email"
          id="email"
          placeholder="Example: levana@gmail.com"
          class="inner-control"
        )
      button(class="inner-button") Send OTP

    .inner-more
      span Do you remember your password?
      a(href=`/${pathAdmin}/account/login`) Login