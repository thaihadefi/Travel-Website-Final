extends ../layouts/default.pug
include ../mixins/options.pug

block main
  
  h1.box-title Website Information

  //- Section 8
  .section-8
    form(id="setting-website-info-form")
      .inner-group
        label(for="websiteName" class="inner-label") Website Name
        input(type="text" id="websiteName" name="websiteName" value=record.websiteName)
      .inner-group
        label(for="phone" class="inner-label") Phone Number
        input(type="text" id="phone" name="phone" value=record.phone)
      .inner-group
        label(for="email" class="inner-label") Email
        input(type="email" id="email" name="email" value=record.email)
      .inner-group
        label(for="address" class="inner-label") Address
        input(type="text" id="address" name="address" value=record.address)
      .inner-group
        label(for="logo" class="inner-label") Logo
        .inner-upload-image(image-default=record.logo)
          input(
            type="file" 
            id="logo"
            name="logo"
            filepond-image
            )
      .inner-group
        label(for="favicon" class="inner-label") Favicon
        .inner-upload-image(image-default=record.favicon)
          input(
            type="file" 
            id="favicon"
            name="favicon"
            filepond-image
            )
      .inner-group
        label(for="categoryIdSection4" class="inner-label") Category for Homepage 1
        select(id="categoryIdSection4" name="categoryIdSection4")
          option(value="") -- Select Category -- 
          +options(categoryList, 0, record.categoryIdSection4)
      .inner-group
        label(for="categoryIdSection6" class="inner-label") Category for Homepage 2
        select(id="categoryIdSection6" name="categoryIdSection6")
          option(value="") -- Select Category -- 
          +options(categoryList, 0, record.categoryIdSection6)
      .inner-group
        label(for="backgroundSection1" class="inner-label") Background Image
        .inner-upload-image(image-default=record.backgroundSection1)
          input(
            type="file" 
            id="backgroundSection1"
            name="backgroundSection1"
            filepond-image
            )
      .inner-group
        label(for="bannersSection3" class="inner-label") Promotional Offers
        .inner-upload-image-multi(list-image-default=record.bannersSection3)
          input(
            type="file" 
            id="bannersSection3"
            name="bannersSection3"
            filepond-image-multi
            multiple
            data-allow-reorder="true"
            data-max-files="10"
            )
      .inner-group
        label(for="bannerSection5" class="inner-label") Banner Large 1
        .inner-upload-image(image-default=record.bannerSection5)
          input(
            type="file" 
            id="bannerSection5"
            name="bannerSection5"
            filepond-image
            )
      .inner-group
        label(for="bannerSection7" class="inner-label") Banner Large 2
        .inner-upload-image(image-default=record.bannerSection7)
          input(
            type="file" 
            id="bannerSection7"
            name="bannerSection7"
            filepond-image
            )
      .inner-button.inner-two-col
        button Update
    .inner-back
      a(href=`/${pathAdmin}/setting/list`) Back to List
  //- End Section 8