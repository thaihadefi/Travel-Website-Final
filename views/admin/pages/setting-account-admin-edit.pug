extends ../layouts/default.pug

block main
  
  h1.box-title Edit Account Admin

  //- Section 8
  .section-8
    form(id="setting-account-admin-edit-form")
      .inner-group(style="display: none;")
        label(for="id" class="inner-label") ID
        input(type="text" id="id" name="id" value=accountDetail.id)
      .inner-group
        label(for="fullName" class="inner-label") Full Name
        input(type="text" id="fullName" name="fullName" value=accountDetail.fullName)
      .inner-group
        label(for="email" class="inner-label") Email
        input(type="email" id="email" name="email" value=accountDetail.email)
      .inner-group
        label(for="phone" class="inner-label") Phone Number
        input(type="text" id="phone" name="phone" value=accountDetail.phone)
      .inner-group
        label(for="role" class="inner-label") Role
        select(id="role" name="role")
          option(value="") -- Select Role --
          each item in roleList
            option(
              value=item.id
              selected=(item.id == accountDetail.role ? true : false)
              ) #{item.name}
      .inner-group
        label(for="positionCompany" class="inner-label") Position
        input(type="text" id="positionCompany" name="positionCompany" value=accountDetail.positionCompany)
      .inner-group
        label(for="status" class="inner-label") Status
        select(id="status" name="status")
          option(
            value="initial"
            selected=(accountDetail.status == "initial" ? true : false)
            ) Initial
          option(
            value="active"
            selected=(accountDetail.status == "active" ? true : false)
            ) Active
          option(
            value="inactive"
            selected=(accountDetail.status == "inactive" ? true : false)
            ) Inactive
      .inner-group
        label(for="password" class="inner-label") Password
        input(type="text" id="password" name="password")
      .inner-group.inner-two-col
        label(for="avatar" class="inner-label") Avatar
        .inner-upload-image(image-default=accountDetail.avatar)
          input(
            type="file" 
            id="avatar"
            name="avatar"
            filepond-image
            )
      .inner-button.inner-two-col
        button Update
    .inner-back
      a(href=`/${pathAdmin}/setting/account-admin/list`) Back to list
  //- End Section 8