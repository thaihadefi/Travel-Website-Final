extends ../layouts/default.pug
include ../mixins/change-status.pug

block main
  
  h1.box-title Category Trash

  //- Section 5
  .section-5
    .inner-wrap
      +change-status(
        `/${pathAdmin}/category/change-multi`,
        [
          {
            label: "Restore",
            value: "undo"
          },
          {
            label: "Delete Permanently",
            value: "destroy"
          }
        ]
      )
      .inner-search
        <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Search")
  //- End Section 5

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th
              input(type="checkbox" class="inner-check" check-all)
            th Category Title
            th(class="inner-center") Avatar
            th(class="inner-center") Position
            th(class="inner-center") Status
            th Created By
            th Deleted By
            th Action
        tbody
          if categoryList.length > 0
            each item in categoryList
              tr
                td
                  input(type="checkbox" class="inner-check" check-item=item.id)
                td #{item.name}
                td(class="inner-center")
                  img(src=item.avatar class="inner-avatar")
                td(class="inner-center") #{item.position}
                td(class="inner-center")
                  if (item.status == "active")
                    .badge.badge-green Active
                  else if (item.status == "inactive")
                    .badge.badge-red Inactive
                td
                  div #{item.createdByFullName}
                  div.inner-time #{item.createdAtFormat}
                td
                  div #{item.deletedByFullName}
                  div.inner-time #{item.deletedAtFormat}
                td
                  .inner-buttons
                    button(
                      class="inner-undo"
                      button-undo
                      data-api=`/${pathAdmin}/category/undo/${item.id}`
                      )
                      <i class="fa-solid fa-rotate-left"></i>
                    button(
                      class="inner-delete"
                      button-destroy
                      data-api=`/${pathAdmin}/category/destroy/${item.id}`
                      )
                      <i class="fa-regular fa-trash-can"></i>
          else
            tr
              td(colspan="8" style="text-align: center; padding: 40px 20px; color: #999;")
                | No categories found.
  //- End Section 6

  //- Section 7
  include ../partials/pagination.pug
  //- End Section 7
