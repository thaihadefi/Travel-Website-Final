extends ../layouts/default.pug

block main
  
  h1.box-title Change Password

  //- Section 8
  .section-8
    form(id="profile-change-password-form")
      .inner-group
        label(for="password" class="inner-label") New Password
        input(type="password" id="password" name="password")
        span(class="inner-toggle-password" toggle-password)
          i.fa-solid.fa-eye
      .inner-group
        label(for="confirmPassword" class="inner-label") Confirm New Password
        input(type="password" id="confirmPassword" name="confirmPassword")
        span(class="inner-toggle-password" toggle-password)
          i.fa-solid.fa-eye
      .inner-button.inner-two-col
        button Change Password
  //- End Section 8