extends ../layouts/account.pug

block main
  .form-account
    h1.inner-title Enter OTP
    .inner-desc Please enter the OTP to continue

    form.inner-form(id="otp-password-form")
      .inner-group
        label(
          for="otp"
          class="inner-label"
        ) OTP
        input(
          type="text"
          name="otp"
          id="otp"
          placeholder="Example: 123456"
          class="inner-control"
        )
      button(class="inner-button") Confirm

    .inner-more
      span Do you remember your password?
      a(href=`/${pathAdmin}/account/login`) Login