extends ../layouts/account.pug

block main
  .form-account
    h1.inner-title Change Password
    .inner-desc Please enter your password to continue

    form.inner-form(id="reset-password-form")
      .inner-group
        label(
          for="password"
          class="inner-label"
        ) New Password
        input(
          type="password"
          name="password"
          id="password"
          class="inner-control"
        )
        span(class="inner-toggle-password" toggle-password)
          i.fa-solid.fa-eye
      .inner-group
        label(
          for="confirm-password"
          class="inner-label"
        ) Confirm Password
        input(
          type="password"
          name="confirmPassword"
          id="confirm-password"
          class="inner-control"
        )
        span(class="inner-toggle-password" toggle-password)
          i.fa-solid.fa-eye
      button(class="inner-button") Change

    .inner-more
      span Do you remember your password?
      a(href=`/${pathAdmin}/account/login`) Login