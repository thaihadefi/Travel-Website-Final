extends ../layouts/default.pug

block main
  
  h1.box-title Create Account Admin

  //- Section 8
  .section-8
    form(id="setting-account-admin-create-form")
      .inner-group
        label(for="fullName" class="inner-label") Full Name
        input(type="text" id="fullName" name="fullName")
      .inner-group
        label(for="email" class="inner-label") Email
        input(type="email" id="email" name="email")
      .inner-group
        label(for="phone" class="inner-label") Phone Number
        input(type="text" id="phone" name="phone")
      .inner-group
        label(for="role" class="inner-label") Role
        select(id="role" name="role")
          each item in roleList
            option(value=item.id) #{item.name}
      .inner-group
        label(for="positionCompany" class="inner-label") Position
        input(type="text" id="positionCompany" name="positionCompany")
      .inner-group
        label(for="status" class="inner-label") Status
        select(id="status" name="status")
          option(value="initial") Initial
          option(value="active") Active
          option(value="inactive") Inactive
      .inner-group
        label(for="password" class="inner-label") Password
        input(type="text" id="password" name="password")
      .inner-group.inner-two-col
        label(for="avatar" class="inner-label") Avatar
        .inner-upload-image
          input(
            type="file" 
            id="avatar"
            name="avatar"
            filepond-image
            )
      .inner-button.inner-two-col
        button Create
    .inner-back
      a(href=`/${pathAdmin}/setting/account-admin/list`) Back to list
  //- End Section 8